@import "tailwindcss";
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Nunito+Sans:wght@400&display=swap');

@theme {
  --color-navy: #2D2F5E;
  --color-verdeSniffer: #78C87A;
  --color-offWhite: #F5F7FA;
  --color-offWhiteBg: #F5F5F0;
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-jakarta: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
  --font-nunito: "Nunito Sans", ui-sans-serif, system-ui, sans-serif;
}

/* Grain texture overlay */
.grain-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.04;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 128px 128px;
}

/* Light glassmorphism step cards */
.step-card-light {
  position: relative;
  background: white;
  box-shadow: 0 2px 12px rgba(45, 47, 94, 0.04);
  border-bottom: 3px solid transparent;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.4s ease,
              box-shadow 0.4s ease;
  overflow: hidden;
}

.step-card-light:hover {
  transform: translateY(-4px);
  border-bottom-color: var(--color-verdeSniffer);
  box-shadow: 0 8px 30px rgba(45, 47, 94, 0.08);
}

.step-card-light:hover .icon-glow {
  filter: drop-shadow(0 0 12px rgba(120, 200, 122, 0.4));
}

.step-card-light .icon-glow {
  transition: filter 0.4s ease;
}

/* Spotlight overlay inside cards */
.card-spotlight {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: inherit;
}

.step-card-light:hover .card-spotlight {
  opacity: 1;
}

/* Particle drift animations */
@keyframes particle-drift {
  0% { transform: translateX(-20px) translateY(0); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateX(calc(100vw + 20px)) translateY(-30px); opacity: 0; }
}

.particle {
  position: absolute;
  border-radius: 50%;
  background-color: var(--color-navy);
  pointer-events: none;
}

.particle-1 { width: 4px; height: 4px; top: 20%; left: -10px; opacity: 0.5; animation: particle-drift 8s linear infinite; }
.particle-2 { width: 3px; height: 3px; top: 45%; left: -10px; opacity: 0.3; animation: particle-drift 11s linear infinite 1.5s; }
.particle-3 { width: 5px; height: 5px; top: 70%; left: -10px; opacity: 0.4; animation: particle-drift 9s linear infinite 3s; }
