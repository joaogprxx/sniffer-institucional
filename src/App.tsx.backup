                <div className="w-12 h-12 bg-navy/5 rounded-2xl flex items-center justify-center text-2xl">🎨</div>
              </div>
              <h4 className="text-xl font-bold mb-2 group-hover:text-verdeSniffer transition-colors">Circuito das Artes</h4>
              <p className="text-navy/60 text-sm mb-4">Visitas guiadas e debates sobre as novas exposições na sua região.</p>
              <div className="flex items-center gap-2 text-xs font-bold text-navy/40 uppercase tracking-wider">
                <span>156 Membros</span>
                <span>•</span>
                <span>Hoje</span>
              </div>
            </div>
            {/* Card 4: BH Foodies */}
            <div className="bg-white p-6 rounded-3xl shadow-sm hover:shadow-md transition-shadow group">
              <div className="mb-4 flex justify-between items-start">
                <div className="w-12 h-12 bg-navy/5 rounded-2xl flex items-center justify-center text-2xl">🧀</div>
              </div>
              <h4 className="text-xl font-bold mb-2 group-hover:text-verdeSniffer transition-colors">Rota Gastronômica</h4>
              <p className="text-navy/60 text-sm mb-4">Explorando os melhores restaurantes, queijos e botecos tradicionais próximos a você.</p>
              <div className="flex items-center gap-2 text-xs font-bold text-navy/40 uppercase tracking-wider">
                <span>890 Membros</span>
                <span>•</span>
                <span>Sábado</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      {/* END: TribesGrid */}

      {/* BEGIN: BottomCTA */}
      <footer className="bg-white py-12 px-4 border-t border-navy/5">
        <div className="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
